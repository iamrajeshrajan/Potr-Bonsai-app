{
  "name": "potr-bonsai-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply potr-bonsai --local",
    "db:migrate:remote": "wrangler d1 migrations apply potr-bonsai --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22",
    "@cloudflare/workers-types": "^4",
    "typescript": "^5",
    "vitest": "~4.1.0",
    "wrangler": "^4"
  }
}
